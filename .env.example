# Copy this file to .env and fill it in. .env is git-ignored: never commit it.

# ---------- AI providers (used to personalize each email) ----------
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# xAI / Grok key: https://console.x.ai
XAI_API_KEY=

# ---------- Sending mailbox (your company's official mail id) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (port 587, default) | ssl (port 465)
SMTP_SECURITY=starttls
SMTP_USER=hello@yourcompany.com
# Gmail / Google Workspace: create an App Password (needs 2-Step Verification on).
# Do NOT put the normal account password here.
SMTP_PASSWORD=
# Display name people see. Leave empty to use company.name from config.yaml
FROM_NAME=Your Name | Your Company
FROM_EMAIL=hello@yourcompany.com
REPLY_TO=hello@yourcompany.com

# ---------- Compliance (shown in every email footer) ----------
COMPANY_ADDRESS=Your Company, <full postal address>
UNSUBSCRIBE_EMAIL=hello@yourcompany.com
