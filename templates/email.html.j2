<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f6f7f9;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f7f9;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:10px;">
<tr><td style="padding:28px 28px 8px 28px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#1d1f23;">
{% for para in paragraphs %}<p style="margin:0 0 14px 0;">{{ para }}</p>
{% endfor %}
<p style="margin:22px 0 0 0;"><strong>{{ sender_name }}</strong><br>{{ sender_title }}</p>
</td></tr>
<tr><td style="padding:18px 28px 26px 28px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:1.5;color:#7a7f87;border-top:1px solid #eceef1;">
Don't want these emails? Reply "unsubscribe" or write to <a href="mailto:{{ unsubscribe_email }}?subject=unsubscribe" style="color:#7a7f87;">{{ unsubscribe_email }}</a>.<br>
{{ company_address }}
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
